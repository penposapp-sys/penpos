{
  "name": "penpos-call-agent",
  "version": "0.1.17",
  "private": true,
  "description": "PenPOS Çağrı Ajanı masaüstü uygulaması",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:4177 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:4177 electron .\"",
    "start": "electron .",
    "build": "vite build",
    "test": "node --test",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.penpos.callagent",
    "productName": "PenPOS Çağrı Ajanı",
    "protocols": [
      {
        "name": "PenPOS Çağrı Ajanı eşleştirme",
        "schemes": [
          "penpos-call-agent"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/serialPortReader.ps1",
        "to": "serialPortReader.ps1"
      },
      {
        "from": "resources/cp210x",
        "to": "cp210x"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@45.2.0": true
  }
}
